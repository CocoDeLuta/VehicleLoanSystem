@page "/Vehicle"
@page "/cadastro-veiculos"
@using VehicleLoan.Model.Basic
@inject HttpClient Http

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-center mb-4">Cadastro de Veículo</h3>

            @if (!string.IsNullOrEmpty(mensagem))
            {
                <div class="alert @(sucesso ? "alert-success" : "alert-danger")" role="alert">
                    @mensagem
                </div>
            }

            <EditForm Model="@vehicle" OnValidSubmit="EnviarVeiculo">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="nome" class="form-label">Nome do Modelo:</label>
                    <InputText id="nome" @bind-Value="vehicle.ModelName" class="form-control" />
                </div>
                
                <div class="mb-3">
                    <label for="ano" class="form-label">Ano:</label>
                    <InputNumber id="ano" @bind-Value="vehicle.Year" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Enviar</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private VehicleModel vehicle = new VehicleModel();
    private string mensagem = string.Empty;
    private bool sucesso = true; // controla o estilo da mensagem (sucesso ou erro)

    private async Task EnviarVeiculo()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/vehicles", vehicle);

            if (response.IsSuccessStatusCode)
            {
                mensagem = "Veículo cadastrada com sucesso!";
                sucesso = true; // exibe a mensagem de sucesso
                vehicle = new VehicleModel(); // limpa o formulário
            }
            else
            {
                mensagem = "Erro ao cadastrar a categoria.";
                sucesso = false; // exibe a mensagem de erro
            }
        }
        catch (Exception ex)
        {
            mensagem = $"Erro na requisição: {ex.Message}";
            sucesso = false;
        }
    }
}